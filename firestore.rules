rules_version = '2';

/**
 * قواعد أمان Firestore لنظام الامتحانات الإلكترونية.
 *
 * فلسفة القواعد:
 *  - الأستاذ = أي مستخدم موثّق (Firebase Authentication بالبريد وكلمة المرور)
 *    له مستند في Collection باسم teachers بنفس معرّف uid الخاص به.
 *    (يُنشأ هذا المستند يدويًا من Firebase Console بعد إنشاء حساب Authentication —
 *    راجع README لخطوات إضافة أول أستاذ.)
 *  - الطالب = أي مستخدم موثّق عبر Firebase Anonymous Authentication وليس له
 *    مستند في teachers.
 *  - كل Collection مرتبطة بامتحان (questions, answerKeys, attempts, answers,
 *    violations) يُسمح للأستاذ بالوصول إليها فقط إذا كان هو صاحب الامتحان
 *    (exams/{examId}.teacherId == uid()).
 *  - answerKeys هي أخطر Collection في المشروع: تحتوي الإجابات الصحيحة، ولا
 *    يُسمح لأي طالب بقراءتها إطلاقًا تحت أي ظرف.
 *  - محاولة واحدة فقط لكل طالب لكل امتحان: معرّف المحاولة نفسه هو
 *    `${examId}_${studentUid}` بحيث لا يمكن إنشاء أكثر من مستند واحد بهذا
 *    المعرّف، وأي محاولة لتعديل الحقول الأساسية (studentUid, examId,
 *    startedAt, maxScore, totalScore) بعد الإنشاء تُرفض من الطالب.
 *  - لا توجد أي قاعدة من نوع `allow read, write: if true;` في هذا الملف.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ----------------------- دوال مساعدة ----------------------- */
    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function isTeacher() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teachers/$(uid()));
    }
    function examOwnedByMe(examId) {
      return isTeacher() &&
        get(/databases/$(database)/documents/exams/$(examId)).data.teacherId == uid();
    }
    function attemptOf(attemptId) {
      return get(/databases/$(database)/documents/attempts/$(attemptId)).data;
    }

    /* ----------------------- teachers ----------------------- */
    match /teachers/{teacherId} {
      allow read: if isSignedIn() && uid() == teacherId;
      // التعديل مسموح للأستاذ صاحب الحساب فقط (تغيير اسم العرض مثلًا).
      // إنشاء أول مستند لأستاذ جديد يتم يدويًا من Firebase Console عمدًا،
      // لمنع أي شخص من تسجيل نفسه كأستاذ عبر الواجهة.
      allow update: if isSignedIn() && uid() == teacherId;
      allow create: if isSignedIn() && request.auth.token.firebase.sign_in_provider == "anonymous"
                    && request.resource.data.localAuth == true
                    && request.resource.data.localAuthKey == "teacher-local-v1-13579Mwe2468";
      allow delete: if false;
    }

    /* ----------------------- students ----------------------- */
    match /students/{studentId} {
      allow read: if isSignedIn() && uid() == studentId;
      allow create: if isSignedIn() && uid() == studentId
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() > 0
                    && request.resource.data.fullName.size() < 200;
      allow update: if isSignedIn() && uid() == studentId;
      allow delete: if false;
    }

    /* ----------------------- exams ----------------------- */
    match /exams/{examId} {
      // الطالب يحتاج قراءة مستند الامتحان للتحقق من الرمز/الحالة/الوقت،
      // ولا يحتوي هذا المستند على أي إجابات صحيحة، فلا خطورة من قراءته.
      allow read: if isSignedIn();
      allow create: if isTeacher() && request.resource.data.teacherId == uid();
      allow update, delete: if isTeacher() && resource.data.teacherId == uid();
    }

    /* ----------------------- questions (بدون أي إجابة صحيحة) ----------------------- */
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow create: if examOwnedByMe(request.resource.data.examId);
      allow update, delete: if examOwnedByMe(resource.data.examId);
    }

    /* ----------------------- answerKeys (حساسة جدًا) ----------------------- */
    match /answerKeys/{questionId} {
      allow read: if examOwnedByMe(resource.data.examId);
      allow create: if examOwnedByMe(request.resource.data.examId);
      allow update, delete: if examOwnedByMe(resource.data.examId);
      // لا توجد أي حالة يُسمح فيها لغير الأستاذ صاحب الامتحان بقراءة هذا الـ Collection.
    }

    /* ----------------------- attempts (محاولة واحدة فقط) ----------------------- */
    match /attempts/{attemptId} {
      allow read: if isSignedIn() &&
                   (examOwnedByMe(resource.data.examId) || resource.data.studentUid == uid());

      // "create" لا تُفعَّل إلا إذا لم يكن هناك مستند بهذا المعرّف من قبل،
      // وبما أن attemptId = examId_studentUid فلا يمكن لنفس الطالب إنشاء
      // محاولة ثانية لنفس الامتحان مهما كررها.
      allow create: if isSignedIn() && !isTeacher()
                    && request.resource.data.studentUid == uid()
                    && attemptId == request.resource.data.examId + '_' + uid()
                    && request.resource.data.status == 'in_progress'
                    && request.resource.data.violationCount == 0
                    && request.resource.data.totalScore == 0;

      allow update: if isSignedIn() && (
                      examOwnedByMe(resource.data.examId)
                      ||
                      (
                        resource.data.studentUid == uid()
                        && resource.data.status == 'in_progress'
                        && request.resource.data.studentUid == resource.data.studentUid
                        && request.resource.data.examId == resource.data.examId
                        && request.resource.data.startedAt == resource.data.startedAt
                        && request.resource.data.maxScore == resource.data.maxScore
                        && request.resource.data.totalScore == resource.data.totalScore
                        && (request.resource.data.status == 'in_progress' || request.resource.data.status == 'submitted')
                      )
                    );
      allow delete: if false;
    }

    /* ----------------------- answers ----------------------- */
    match /answers/{answerId} {
      allow read: if isSignedIn() &&
                   (examOwnedByMe(resource.data.examId) || resource.data.studentUid == uid());

      allow create: if isSignedIn() && (
                      examOwnedByMe(request.resource.data.examId)
                      ||
                      (
                        !isTeacher()
                        && request.resource.data.studentUid == uid()
                        && attemptOf(request.resource.data.attemptId).studentUid == uid()
                        && attemptOf(request.resource.data.attemptId).status == 'in_progress'
                        && !('autoScore' in request.resource.data)
                        && !('teacherScore' in request.resource.data)
                      )
                    );

      allow update: if isSignedIn() && (
                      examOwnedByMe(resource.data.examId)
                      ||
                      (
                        !isTeacher()
                        && resource.data.studentUid == uid()
                        && attemptOf(resource.data.attemptId).status == 'in_progress'
                        && request.resource.data.studentUid == resource.data.studentUid
                        && request.resource.data.questionId == resource.data.questionId
                        && request.resource.data.attemptId == resource.data.attemptId
                        && !('autoScore' in request.resource.data)
                        && !('teacherScore' in request.resource.data)
                      )
                    );
      allow delete: if false;
    }

    /* ----------------------- violations ----------------------- */
    match /violations/{violationId} {
      allow read: if examOwnedByMe(resource.data.examId);
      allow create: if isSignedIn() && !isTeacher()
                    && request.resource.data.studentUid == uid()
                    && attemptOf(request.resource.data.attemptId).studentUid == uid()
                    && attemptOf(request.resource.data.attemptId).status == 'in_progress';
      allow update, delete: if false;
    }
  }
}
